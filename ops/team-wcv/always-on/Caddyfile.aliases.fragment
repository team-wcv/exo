# BEGIN team-wcv inference aliases
http://laguna.localhost:18888 {
	rewrite * /laguna{uri}
	reverse_proxy 100.73.100.108:18889 {
		flush_interval -1
	}
}

http://studio-ai.localhost:18888 {
	rewrite * /studio{uri}
	reverse_proxy 100.73.100.108:18889 {
		flush_interval -1
	}
}
# END team-wcv inference aliases
