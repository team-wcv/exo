{
	auto_https off
	admin localhost:2019
}

# Client ingress prefers Studio and falls back to the MacBook APIs.
# These tailnet addresses do not change the LAN/RDMA inference topology.
http://bigbrain.localhost:18888, http://bigbrain-local.localhost:18888 {
	# Bootstrap documents must not outlive the immutable assets they reference.
	@dashboard_bootstrap path / /index.html /_app/version.json
	header @dashboard_bootstrap Cache-Control "no-store"
	reverse_proxy 100.73.100.108:52415 100.82.178.117:52415 100.80.253.10:52415 {
		lb_policy first
		health_uri /node_id
		health_interval 10s
		health_timeout 2s
		lb_try_duration 3s
	}

	log {
		output file /Users/JJ/.config/caddy/bigbrain.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
